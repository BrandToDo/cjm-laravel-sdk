{
    "name": "customer-journey-platform/laravel-sdk",
    "description": "Laravel package wrapping the Customer Journey Platform sync API (/api/v1/customers, /api/v1/interactions). Internal use only, not published to Packagist.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CustomerJourneyPlatform\\LaravelSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CustomerJourneyPlatform\\LaravelSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CustomerJourneyPlatform\\LaravelSdk\\PlatformServiceProvider"
            ],
            "aliases": {
                "Platform": "CustomerJourneyPlatform\\LaravelSdk\\Facades\\Platform"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=unit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
